
@model QPET.Models.AdminProductViewModel

@{
    ViewData["Title"] = "Create Product";

    var categories =
        ViewBag.Categories as List<QPET.Data.Entities.Category>
        ?? new List<QPET.Data.Entities.Category>();

    var subCategories =
        ViewBag.SubCategories as List<QPET.Data.Entities.SubCategory>
        ?? new List<QPET.Data.Entities.SubCategory>();
}

<div id="createProductPage" class="ap-page">

    <div class="admin-page-heading ap-heading">
        <div>
            <span class="eyebrow">CATALOGUE MANAGEMENT</span>
            <h1>Add New Product</h1>
            <p>Create a product listing for the QPET catalogue.</p>
        </div>

        <a asp-controller="Admin"
           asp-action="Products"
           class="btn btn-secondary">
            ← Back to Products
        </a>
    </div>

    <form asp-controller="Admin"
          asp-action="CreateProduct"
          method="post"
          enctype="multipart/form-data"
          id="productForm">

        <div asp-validation-summary="ModelOnly"
             class="ap-validation"
             role="alert"></div>

        <div class="ap-editor-grid">

            <div class="ap-editor-main">

                <section class="ap-card ap-form-card">
                    <div class="ap-card-heading">
                        <div>
                            <h2>Product Information</h2>
                            <p>Enter the basic details of the product.</p>
                        </div>
                    </div>

                    <div class="ap-form-content">
                        <div class="ap-field">
                            <label asp-for="ProductName"></label>

                            <input asp-for="ProductName"
                                   placeholder="e.g. 500ml PET Water Bottle" />

                            <span asp-validation-for="ProductName"
                                  class="ap-field-error"></span>
                        </div>

                        <div class="ap-form-row">
                            <div class="ap-field">
                                <label asp-for="CategoryId"></label>

                                <select asp-for="CategoryId"
                                        id="productCategory">
                                    <option value="0">Select Category</option>

                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.CategoryId">
                                            @category.CategoryName
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="ap-field-error"></span>
                            </div>

                            <div class="ap-field">
                                <label asp-for="SubCategoryId"></label>

                                <select asp-for="SubCategoryId"
                                        id="productSubCategory"
                                        data-selected-subcategory="@Model.SubCategoryId">
                                    <option value="">Select Subcategory</option>

                                    @foreach (var subCategory in subCategories)
                                    {
                                        <option value="@subCategory.SubCategoryId"
                                                data-category-id="@subCategory.CategoryId">
                                            @subCategory.SubCategoryName
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="SubCategoryId"
                                      class="ap-field-error"></span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="ap-card ap-form-card">
                    <div class="ap-card-heading">
                        <div>
                            <h2>Product Specifications</h2>
                            <p>Provide the physical product details.</p>
                        </div>
                    </div>

                    <div class="ap-form-content">
                        <div class="ap-form-row">
                            <div class="ap-field">
                                <label asp-for="CapacityVolume"></label>

                                <input asp-for="CapacityVolume"
                                       placeholder="e.g. 500ml, 1L, 2L" />

                                <span asp-validation-for="CapacityVolume"
                                      class="ap-field-error"></span>
                            </div>

                            <div class="ap-field">
                                <label asp-for="NeckFinish"></label>

                                <input asp-for="NeckFinish"
                                       placeholder="e.g. 28mm" />

                                <span asp-validation-for="NeckFinish"
                                      class="ap-field-error"></span>
                            </div>
                        </div>

                        <div class="ap-field">
                            <label asp-for="Description"></label>

                            <textarea asp-for="Description"
                                      rows="6"
                                      placeholder="Describe the product, its features and intended use."></textarea>

                            <span asp-validation-for="Description"
                                  class="ap-field-error"></span>
                        </div>
                    </div>
                </section>
            </div>

            <aside class="ap-editor-side">

                <section class="ap-card ap-form-card">
                    <div class="ap-card-heading">
                        <div>
                            <h2>Product Image</h2>
                            <p>Upload a clear product photograph.</p>
                        </div>
                    </div>

                    <div class="ap-form-content">
                        <div class="ap-image-preview">
                            <img id="productImagePreview"
                                 alt="Selected product preview"
                                 hidden />

                            <span id="productImagePlaceholder">
                                No image selected
                            </span>
                        </div>

                        <div class="ap-field">
                            <label asp-for="Image">Upload Image</label>

                            <input asp-for="Image"
                                   id="productImageInput"
                                   type="file"
                                   accept=".jpg,.jpeg,.png,.webp" />

                            <small>
                                JPG, PNG or WebP.
                                File validation is performed before upload.
                            </small>

                            <span asp-validation-for="Image"
                                  class="ap-field-error"></span>
                        </div>
                    </div>
                </section>

                <section class="ap-card ap-form-card">
                    <div class="ap-card-heading">
                        <div>
                            <h2>Visibility</h2>
                            <p>Control the product's public status.</p>
                        </div>
                    </div>

                    <div class="ap-form-content">
                        <label class="ap-toggle-row">
                            <input asp-for="IsActive" />
                            <span>
                                <strong>Active Product</strong>
                                <small>
                                    Show this product in the public catalogue.
                                </small>
                            </span>
                        </label>
                    </div>
                </section>
            </aside>

        </div>

        <div class="ap-form-footer">
            <a asp-controller="Admin"
               asp-action="Products"
               class="btn btn-secondary">
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">
                Create Product →
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/admin-products-form.js"
            asp-append-version="true"></script>
}
