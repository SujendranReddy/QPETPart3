
@model QPET.Models.AdminEnquiryListViewModel

@{
    ViewData["Title"] = "Enquiries";

    var customers =
        ViewBag.Customers as List<QPET.Data.Entities.Customer>
        ?? new List<QPET.Data.Entities.Customer>();

    var branches =
        ViewBag.Branches as List<QPET.Data.Entities.Branch>
        ?? new List<QPET.Data.Entities.Branch>();

    var statuses = new Dictionary<string, string>
    {
        { "New", "New" },
        { "InProgress", "In Progress" },
        { "Resolved", "Resolved" },
        { "Closed", "Closed" }
    };

    var resultCount = Model.Enquiries.Count();
}

<div id="adminEnquiriesPage">

    <div class="admin-page-heading">
        <div>
            <span class="eyebrow">
                Customer requests
            </span>

            <h1>Enquiries</h1>

            <p>
                Review customer enquiries and manage their
                progress through the QPET enquiry process.
            </p>
        </div>
    </div>

    <section class="admin-table-panel">

        <div class="admin-table-toolbar">
            <div>
                <h2>Customer enquiries</h2>

                <p>
                    @if (Model.HasActiveFilters)
                    {
                        <text>
                            Showing @resultCount of
                            @Model.TotalCount enquiries
                        </text>
                    }
                    else
                    {
                        <text>
                            @resultCount
                            @(resultCount == 1 ? "enquiry" : "enquiries")
                        </text>
                    }
                </p>
            </div>
        </div>

        <form asp-controller="Admin"
              asp-action="Enquiries"
              method="get"
              class="ap-filters">

            <div class="ap-field">
                <label for="enquirySearch">
                    Search enquiries
                </label>

                <input id="enquirySearch"
                       type="search"
                       name="search"
                       value="@Model.Search"
                       placeholder="Reference, name, email or subject" />
            </div>

            <div class="ap-field">
                <label for="enquiryStatus">
                    Status
                </label>

                <select id="enquiryStatus"
                        name="status"
                        class="admin-filter-control">

                    <option value=""
                            selected="@(string.IsNullOrWhiteSpace(Model.SelectedStatus))">
                        All statuses
                    </option>

                    @foreach (var status in statuses)
                    {
                        <option value="@status.Key"
                                selected="@(Model.SelectedStatus == status.Key)">
                            @status.Value
                        </option>
                    }
                </select>
            </div>

            <div class="ap-field">
                <label for="enquiryBranch">
                    Branch
                </label>

                <select id="enquiryBranch"
                        name="branchId"
                        class="admin-filter-control">

                    <option value=""
                            selected="@(!Model.SelectedBranchId.HasValue)">
                        All branches
                    </option>

                    @foreach (var branch in branches)
                    {
                        <option value="@branch.BranchId"
                                selected="@(Model.SelectedBranchId == branch.BranchId)">
                            @branch.BranchName
                        </option>
                    }
                </select>
            </div>

            <div class="ap-field">
                <label for="enquiryFromDate">
                    From date
                </label>

                <input id="enquiryFromDate"
                       type="date"
                       name="fromDate"
                       value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="ap-field">
                <label for="enquiryToDate">
                    To date
                </label>

                <input id="enquiryToDate"
                       type="date"
                       name="toDate"
                       value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="ap-field">
                <label>
                    Filter actions
                </label>

                <div class="ap-filter-actions">
                    <button type="submit"
                            class="btn btn-primary">
                        Apply Filters
                    </button>

                    <a asp-controller="Admin"
                       asp-action="Enquiries"
                       class="btn btn-secondary">
                        Reset
                    </a>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.FilterError))
            {
                <div class="validation-summary"
                     role="alert"
                     style="grid-column: 1 / -1;">
                    @Model.FilterError
                </div>
            }

        </form>

        @if (Model.Enquiries.Any())
        {
            <div class="admin-table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Customer</th>
                            <th>Branch</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var enquiry in Model.Enquiries)
                        {
                            var customer = customers.FirstOrDefault(
                                item => item.CustomerId == enquiry.CustomerId);

                            var branch = branches.FirstOrDefault(
                                item => item.BranchId == enquiry.BranchId);

                            var statusClass = enquiry.Status switch
                            {
                                "New" => "admin-status-new",
                                "InProgress" => "admin-status-inprogress",
                                "Resolved" => "admin-status-resolved",
                                "Closed" => "admin-status-closed",
                                _ => ""
                            };

                            var displayStatus = enquiry.Status == "InProgress"
                                ? "In Progress"
                                : enquiry.Status;

                            var displayDate =
                                enquiry.CreatedDate.ToString("dd MMM yyyy");

                            <tr>
                                <td>
                                    <strong class="admin-enquiry-reference">
                                        ENQ-@enquiry.EnquiryId
                                    </strong>
                                </td>

                                <td>
                                    <div class="admin-table-primary">
                                        <strong>
                                            @(customer?.FullName
                                              ?? "Unknown customer")
                                        </strong>

                                        <span>
                                            @(customer?.EmailAddress
                                              ?? "No email")
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    @(branch?.BranchName ?? "—")
                                </td>

                                <td>
                                    <div class="admin-table-primary">
                                        <strong>
                                            @enquiry.Subject
                                        </strong>

                                        <span>
                                            @displayDate
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <span class="admin-status-badge @statusClass">
                                        @displayStatus
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="Admin"
                                       asp-action="EnquiryDetails"
                                       asp-route-id="@enquiry.EnquiryId"
                                       class="admin-action-button">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="admin-table-empty">
                @if (Model.HasActiveFilters)
                {
                    <p>
                        No enquiries match your filters.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Enquiries"
                       class="btn btn-secondary">
                        Clear Filters
                    </a>
                }
                else
                {
                    <p>
                        No customer enquiries have been submitted yet.
                    </p>
                }
            </div>
        }

    </section>
</div>
