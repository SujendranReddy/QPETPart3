@{
    ViewData["Title"] = "About Us";
}


<section class="about-hero">

    <div class="about-hero-background">

        <img src="@Url.Content("~/media/images/preforms-production.jpg")"
             alt="PET preforms prepared for packaging production" />

    </div>


    <div class="about-hero-overlay"></div>
    <div class="about-hero-grid"></div>


    <div class="container about-hero-content">

        <span class="eyebrow">
            About QPET
        </span>


        <h1>
            Packaging expertise built around

            <span class="text-gradient">
                quality and innovation.
            </span>
        </h1>


        <p>
            QPET is a South African PET packaging company combining
            food-safety standards, responsible plastics practices,
            advanced manufacturing technology and competitive production.
        </p>

    </div>

</section>



<section class="section">

    <div class="container about-story-grid">



        <div class="about-story-copy">

            <span class="eyebrow">
                Who we are
            </span>


            <h2>
                A modern approach to

                <span class="text-gradient">
                    liquid packaging.
                </span>
            </h2>


            <p>
                QPET provides PET packaging solutions for businesses
                operating across beverage, food, household and
                industrial markets.
            </p>


            <p>
                Through efficient local production, modern technology
                and a focus on consistent quality, QPET supports
                customers requiring dependable packaging solutions
                at competitive commercial pricing.
            </p>


            <div class="about-highlight">

                <span>
                    “
                </span>


                <p>
                    High-quality packaging should combine safety,
                    manufacturing efficiency, innovation and value.
                </p>

            </div>

        </div>




        <div class="about-information-panel">

            <div class="panel-glow"></div>


            <span class="about-panel-number">
                01
            </span>


            <h3>
                Our focus
            </h3>


            <ul class="about-check-list">

                <li>
                    FSSC 22000 food-safety accreditation
                </li>

                <li>
                    Responsible Plastics Converter
                </li>

                <li>
                    Registered with EWASA, a registered PRO
                </li>

                <li>
                    Competitive low-cost production
                </li>

                <li>
                    Advanced high-speed manufacturing technology
                </li>

            </ul>

        </div>

    </div>

</section>


<section class="section about-manufacturing-section">

    <div class="container about-manufacturing-grid">



        <div class="about-video-card">

            <video autoplay
                   muted
                   loop
                   playsinline
                   preload="metadata"
                   poster="@Url.Content("~/media/images/preforms-production.jpg")">

                <source src="@Url.Content("~/media/videos/manufacturing-machine.mp4")"
                        type="video/mp4" />

            </video>


            <div class="about-video-overlay"></div>


            <div class="about-video-caption">

                <span>
                    Manufacturing capability
                </span>

                <strong>
                    High-speed technology. Consistent quality.
                </strong>

            </div>

        </div>




        <div class="about-manufacturing-copy">

            <span class="eyebrow">
                How we work
            </span>


            <h2>
                Modern capability with

                <span class="text-gradient">
                    efficient production.
                </span>
            </h2>


            <p>
                QPET combines advanced production technology with
                efficient manufacturing processes to support quality,
                speed and competitive commercial supply.
            </p>



            <div class="about-process-list">



                <article>

                    <span>
                        01
                    </span>


                    <div>

                        <h3>
                            Advanced manufacturing technology
                        </h3>

                        <p>
                            QPET uses the latest production technology
                            to support high-speed manufacturing while
                            maintaining consistent, high-quality output.
                        </p>

                    </div>

                </article>




                <article>

                    <span>
                        02
                    </span>


                    <div>

                        <h3>
                            Competitive production
                        </h3>

                        <p>
                            QPET prides itself on being a low-cost producer,
                            allowing the company to maintain efficient
                            production and offer competitive pricing.
                        </p>

                    </div>

                </article>




                <article>

                    <span>
                        03
                    </span>


                    <div>

                        <h3>
                            Local manufacturing innovation
                        </h3>

                        <p>
                            QPET is the first company in South Africa
                            to locally produce both 28mm and 38mm
                            tethered closures.
                        </p>

                    </div>

                </article>

            </div>

        </div>

    </div>

</section>



<section class="section">

    <div class="container">


        <div class="about-section-heading">

            <span class="eyebrow">
                What defines QPET
            </span>


            <h2>
                Standards and capabilities that

                <span class="text-gradient">
                    set QPET apart.
                </span>
            </h2>

        </div>



        <div class="about-values-grid">



            <article class="about-value-card">

                <span>
                    01
                </span>


                <h3>
                    Food Safety
                </h3>


                <p>
                    FSSC 22000 accreditation supports QPET's
                    commitment to recognised food-safety standards
                    for packaging manufacturing.
                </p>

            </article>




            <article class="about-value-card">

                <span>
                    02
                </span>


                <h3>
                    Responsibility
                </h3>


                <p>
                    QPET is a Responsible Plastics Converter and is
                    registered with EWASA, a registered PRO,
                    supporting responsible plastics practices.
                </p>

            </article>




            <article class="about-value-card">

                <span>
                    03
                </span>


                <h3>
                    Competitiveness
                </h3>


                <p>
                    Efficient low-cost production allows QPET to
                    offer customers competitive pricing while
                    maintaining manufacturing quality.
                </p>

            </article>




            <article class="about-value-card">

                <span>
                    04
                </span>


                <h3>
                    Innovation
                </h3>


                <p>
                    Advanced technology supports high-speed,
                    high-quality output, while local production of
                    28mm and 38mm tethered closures demonstrates
                    South African manufacturing innovation.
                </p>

            </article>

        </div>

    </div>

</section>




<section class="about-cta">

    <div class="about-cta-glow"></div>


    <div class="container about-cta-content">


        <div>

            <span class="eyebrow">
                Start a conversation
            </span>


            <h2>
                Need reliable packaging at competitive commercial pricing?
            </h2>


            <p>
                Explore the QPET product catalogue or contact the team
                to discuss your capacity, closure, material and
                packaging requirements.
            </p>

        </div>



        <div class="about-cta-actions">


            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-light">

                Explore products

            </a>


            <a asp-controller="Contact"
               asp-action="Index"
               class="btn btn-secondary">

                Contact QPET

            </a>

        </div>

    </div>

</section>