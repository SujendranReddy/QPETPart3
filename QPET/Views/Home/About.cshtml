            <p>
                A complete PET range for edible oil, water, juice,
                sauce, spice, dairy and beverage customers.
            </p>
        </div>

        <div class="qa-product-grid">

            <article class="qa-product-card">

                <div class="qa-product-visual qa-product-photo qa-photo-preforms">
                    <img src="@Url.Content("~/media/about/preforms.png")"
                         alt="Coloured PET preforms"
                         loading="lazy"
                         decoding="async" />
                </div>

                <div class="qa-product-content">
                    <h3>PET Preforms</h3>

                    <p>
                        Injection-moulded preforms for consistent,
                        high-quality bottle production.
                    </p>
                </div>

            </article>

            <article class="qa-product-card">

                <div class="qa-product-visual qa-product-photo qa-photo-bottles">
                    <img src="@Url.Content("~/media/about/bottles.jpeg")"
                         alt="A selection of plastic beverage bottles"
                         loading="lazy"
                         decoding="async" />
                </div>

                <div class="qa-product-content">
                    <h3>PET Bottles</h3>

                    <p>
                        Lightweight, durable and recyclable bottles
                        for liquid packaging.
                    </p>
                </div>

            </article>

            <article class="qa-product-card">

                <div class="qa-product-visual qa-product-photo qa-photo-jars">
                    <img src="@Url.Content("~/media/about/jars.png")"
                         alt="Clear PET jars in different sizes"
                         loading="lazy"
                         decoding="async" />
                </div>

                <div class="qa-product-content">
                    <h3>PET Jars</h3>

                    <p>
                        Strong, clear and versatile jars for food
                        products such as pickles and sauces.
                    </p>
                </div>

            </article>

            <article class="qa-product-card">

                <div class="qa-product-visual qa-product-photo qa-photo-closures">
                    <img src="@Url.Content("~/media/about/closures.png")"
                         alt="Different styles of plastic caps and closures"
                         loading="lazy"
                         decoding="async" />
                </div>

                <div class="qa-product-content">
                    <h3>Caps &amp; Closures</h3>

                    <p>
                        Secure, tamper-evident closures, including
                        28mm and 38mm tethered options.
                    </p>
                </div>

            </article>

            <article class="qa-product-card">

    <div class="qa-product-visual qa-product-photo qa-photo-custom">
        <img src="@Url.Content("~/media/about/custom-solutions.jpg")"
             alt="Custom PET packaging solutions"
             loading="lazy"
             decoding="async" />
    </div>

    <div class="qa-product-content">
        <h3>Custom Solutions</h3>

        <p>
            Packaging tailored to your product,
            volume and brand requirements.
        </p>
    </div>

</article>

        </div>
    </div>
</section>


    <section class="qa-cta">
        <div class="qa-container qa-cta-grid">

            <div>
                <span class="qa-eyebrow qa-eyebrow-light">
                    LET'S WORK TOGETHER
                </span>

                <h2>Have a packaging requirement in mind?</h2>

                <p>
                    Our team is ready to help you find the right
                    packaging solution for your business.
                </p>
            </div>

            <a asp-controller="Contact"
               asp-action="Index"
               class="qa-button qa-button-light">
                Want to know more about our services? Contact us
                <span aria-hidden="true">→</span>
            </a>

        </div>
    </section>

</div>
