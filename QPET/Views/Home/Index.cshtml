@{
    ViewData["Title"] = "Home";
}

<section class="home-hero">
    <video class="hero-background-video"
           autoplay
           muted
           loop
           playsinline
           preload="metadata"
           poster="@Url.Content("~/media/images/preforms-production.jpg")"
           aria-hidden="true">
        <source src="@Url.Content("~/media/videos/hero-bottling.mp4")"
                type="video/mp4" />
    </video>

    <div class="hero-video-overlay"></div>
    <div class="hero-grid-overlay"></div>
    <div class="hero-blue-glow"></div>
    <div class="hero-green-glow"></div>

    <div class="container home-hero-content">
        <div class="hero-copy">
            <span class="eyebrow">South African liquid packaging</span>

            <h1>
                Precision packaging
                <span class="text-gradient">built for growth.</span>
            </h1>

            <p class="hero-description">
                From PET preforms to bottle closures, QPET supplies packaging
                solutions for businesses that value quality, reliability and
                locally manufactured products.
            </p>

            <div class="hero-actions">
                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-primary">
                    Explore our products
                    <span aria-hidden="true">→</span>
                </a>

                <a asp-controller="Contact"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Send an enquiry
                </a>
            </div>
        </div>

        <aside class="hero-information-card">
            <div class="hero-card-top">
                <span class="live-indicator">
                    <span></span>
                    QPET manufacturing
                </span>
            </div>

            <div class="hero-card-content">
                <span class="hero-card-kicker">A closer look</span>
                <h2>Supporting the next generation of packaging.</h2>
                <p>
                    QPET invests in production capabilities that meet evolving
                    packaging needs, including locally produced tethered closures.
                </p>
            </div>

            <div class="hero-card-statistics">
                <div>
                    <strong>28 / 38mm</strong>
                    <span>Tethered closure formats</span>
                </div>
                <div>
                    <strong>PET</strong>
                    <span>Packaging expertise</span>
                </div>
                <div>
                    <strong>SA</strong>
                    <span>Local manufacturing</span>
                </div>
            </div>
        </aside>
    </div>

    <a href="#quality-and-responsibility"
       class="hero-scroll-indicator"
       aria-label="Scroll to learn more">
        <span>Scroll to explore</span>
        <span class="scroll-line"></span>
    </a>
</section>

<section class="section responsibility-section"
         id="quality-and-responsibility">
    <div class="container">
        <div class="responsibility-heading">
            <span class="eyebrow">What matters to QPET</span>
            <h2>
                A strong foundation for
                <span class="text-gradient">every product.</span>
            </h2>
            <p>
                Our approach brings together food safety, responsible plastics
                practices and commercial value.
            </p>
        </div>

        <div class="responsibility-grid">
            <article class="responsibility-card">
                <div class="responsibility-card-top">
                    <span class="responsibility-label">Food safety</span>
                </div>
                <div class="responsibility-icon" aria-hidden="true">✓</div>
                <h3>FSSC 22000</h3>
                <p>
                    QPET's FSSC 22000 accreditation reflects its focus on
                    recognised food-safety requirements for packaging production.
                </p>
            </article>

            <article class="responsibility-card">
                <div class="responsibility-card-top">
                    <span class="responsibility-label">Responsible practices</span>
                </div>
                <div class="responsibility-icon" aria-hidden="true">♻</div>
                <h3>Responsible Plastics Converter</h3>
                <p>
                    QPET is a Responsible Plastics Converter and is registered
                    with EWASA, a producer responsibility organisation.
                </p>
            </article>

            <article class="responsibility-card">
                <div class="responsibility-card-top">
                    <span class="responsibility-label">Commercial value</span>
                </div>
                <div class="responsibility-icon" aria-hidden="true">◫</div>
                <h3>Competitive production</h3>
                <p>
                    Efficient manufacturing helps QPET offer competitively
                    priced packaging for business customers.
                </p>
            </article>
        </div>
    </div>
</section>

<section class="section introduction-section">
    <div class="container introduction-grid">
        <div class="introduction-image-card">
            <img src="@Url.Content("~/media/images/preform-closeup.jpg")"
                 alt="Close-up view of a transparent PET preform"
                 loading="lazy" />

            <div class="introduction-image-overlay"></div>

            <div class="image-card-caption">
                <span>Inside the process</span>
                <strong>Precision begins with every preform.</strong>
            </div>
        </div>

        <div class="introduction-copy">
            <span class="eyebrow">Discover QPET</span>
            <h2>
                Packaging with
                <span class="text-gradient">purpose and precision.</span>
            </h2>

            <p>
                PET packaging is more than the finished bottle. The preform,
                closure and container each play a part in how packaging performs
                throughout filling, handling and everyday use.
            </p>

            <p>
                Learn more about QPET's manufacturing story and the technology
                behind its approach to liquid packaging.
            </p>

            <a asp-controller="Home"
               asp-action="About"
               class="text-link">
                Discover the QPET story
                <span aria-hidden="true"> →</span>
            </a>
        </div>
    </div>
</section>
