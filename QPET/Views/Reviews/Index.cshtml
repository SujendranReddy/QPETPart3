@model QPET.Models.ReviewsPageViewModel

@{
    ViewData["Title"] = "Reviews";
}


<section class="reviews-hero">

    <div class="reviews-hero-background">

        <img src="@Url.Content("~/media/images/preforms-production.jpg")"
             alt="QPET PET packaging manufacturing" />

    </div>


    <div class="reviews-hero-overlay"></div>
    <div class="reviews-hero-grid"></div>


    <div class="container reviews-hero-content">

        <span class="eyebrow">
            Customer experiences
        </span>


        <h1>
            Feedback that builds

            <span class="text-gradient">
                confidence.
            </span>
        </h1>


        <p>
            Read customer experiences with QPET or submit feedback
            about the products, service and support received from
            a QPET branch.
        </p>

    </div>

</section>



<section class="section reviews-main-section">

    <div class="container reviews-layout">


        <div>

            <div class="reviews-content-heading">

                <span class="eyebrow">
                    Customer feedback
                </span>


                <h2>
                    What customers say about

                    <span class="text-gradient">
                        QPET.
                    </span>
                </h2>


                <p>
                    Reviews in this interactive prototype demonstrate
                    how customer feedback can be displayed and moderated.
                </p>


                <span class="review-count-label">

                    @Model.Reviews.Count
                    @(Model.Reviews.Count == 1
                                        ? "customer review"
                                        : "customer reviews")

                </span>

            </div>


            @if (Model.Reviews.Any())
            {
                <div class="public-review-grid">

                    @foreach (var review in Model.Reviews)
                    {
                        var branch =
                        Model.Branches.FirstOrDefault(
                        branch =>
                        branch.BranchId ==
                        review.BranchId
                        );


                        var stars =
                        new string(
                        '★',
                        review.Rating
                        )
                        +
                        new string(
                        '☆',
                        5 - review.Rating
                        );


                        var displayDate =
                        DateTime.TryParse(
                        review.CreatedDate,
                        out var parsedDate
                        )
                        ? parsedDate.ToString(
                        "dd MMM yyyy"
                        )
                        : review.CreatedDate;


                        <article class="public-review-card">

                            <div class="review-card-top">

                                <span class="review-stars">
                                    @stars
                                </span>


                                <span class="review-branch">

                                    @(branch?.BranchName
                                                                ?? "QPET")

                        </span>

                            </div>


                            <div class="review-quote-mark">
                                “
                            </div>


                            <p class="public-review-message">
                                @review.ReviewMessage
                            </p>


                            <div class="review-footer">

                                <strong>
                                    @review.DisplayName
                                </strong>

                                <span>
                                    @displayDate
                                </span>

                            </div>

                        </article>
                                }

                </div>
            }
            else
            {
                <div class="reviews-empty-state">

                    No reviews have been submitted yet.

                </div>
            }

        </div>



        <aside class="reviews-form-card">

            <span class="section-kicker">
                Submit a review
            </span>


            <h2>
                Tell us about your experience.
            </h2>


            <p>
                Select the relevant QPET branch and
                share your feedback.
            </p>


            @if (
                        TempData["ReviewMessage"]
                        is string successMessage)
            {
                <div class="review-success">

                    ✓ @successMessage

                </div>
            }


            <form asp-controller="Reviews"
                  asp-action="SubmitReview"
                  method="post"
                  class="review-form">


                <div class="contact-form-field">

                    <label asp-for="Review.DisplayName">
                        Display Name
                    </label>


                    <input asp-for="Review.DisplayName"
                           class="contact-control"
                           placeholder="Name displayed with your review" />


                    <span asp-validation-for="Review.DisplayName"
                          class="field-validation">
                    </span>

                </div>



                <div class="contact-form-field">

                    <label asp-for="Review.EmailAddress">
                        Email Address
                    </label>


                    <input asp-for="Review.EmailAddress"
                           class="contact-control"
                           placeholder="Optional" />


                    <small class="contact-field-note">
                        Optional and not displayed publicly.
                    </small>


                    <span asp-validation-for="Review.EmailAddress"
                          class="field-validation">
                    </span>

                </div>



                <div class="review-form-row">


                    <div class="contact-form-field">

                        <label asp-for="Review.BranchId">
                            QPET Branch
                        </label>


                        <select asp-for="Review.BranchId"
                                class="contact-control">

                            <option value="0">
                                Select branch
                            </option>


                            @foreach (
                                                        var branch in Model.Branches)
                            {
                                <option value="@branch.BranchId">

                                    @branch.BranchName

                                </option>
                            }

                        </select>


                        <span asp-validation-for="Review.BranchId"
                              class="field-validation">
                        </span>

                    </div>



                    <div class="contact-form-field">

                        <label asp-for="Review.Rating">
                            Rating
                        </label>


                        <select asp-for="Review.Rating"
                                class="contact-control">

                            <option value="0">
                                Select rating
                            </option>

                            <option value="5">
                                5 - Excellent
                            </option>

                            <option value="4">
                                4 - Very Good
                            </option>

                            <option value="3">
                                3 - Good
                            </option>

                            <option value="2">
                                2 - Fair
                            </option>

                            <option value="1">
                                1 - Poor
                            </option>

                        </select>


                        <span asp-validation-for="Review.Rating"
                              class="field-validation">
                        </span>

                    </div>

                </div>



                <div class="contact-form-field">

                    <label asp-for="Review.ReviewMessage">
                        Review
                    </label>


                    <textarea asp-for="Review.ReviewMessage"
                              class="contact-control contact-textarea review-textarea"
                              placeholder="Share your experience with QPET...">
                    </textarea>


                    <span asp-validation-for="Review.ReviewMessage"
                          class="field-validation">
                    </span>

                </div>



                <button type="submit"
                        class="btn btn-primary contact-submit-button">

                    Submit review

                    <span aria-hidden="true">
                        →
                    </span>

                </button>

            </form>

        </aside>

    </div>

</section>