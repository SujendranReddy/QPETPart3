
@model QPET.Models.ReviewsPageViewModel

@{
    ViewData["Title"] = "Reviews";
}

<div class="qrv-page">

    <section class="qrv-hero">
        <img src="@Url.Content("~/media/images/preforms-production.jpg")"
             alt=""
             class="qrv-hero-image"
             aria-hidden="true" />

        <div class="qrv-container qrv-hero-content">
            <span class="qrv-eyebrow qrv-eyebrow-light">
                CUSTOMER EXPERIENCES
            </span>

            <h1>
                Feedback that builds
                <span>confidence.</span>
            </h1>

            <p>
                Discover what customers have to say about QPET's
                packaging, service and support, or share your
                own experience with our team.
            </p>

            <a href="#shareReview" class="qrv-hero-link">
                Share your experience
                <span aria-hidden="true">↓</span>
            </a>
        </div>
    </section>

    <section class="qrv-main">
        <div class="qrv-container">

            <div class="qrv-layout">

                <div class="qrv-reviews-column">

                    <div class="qrv-section-heading">
                        <span class="qrv-eyebrow">
                            CUSTOMER FEEDBACK
                        </span>

                        <h2>
                            What our customers
                            <span class="qrv-gradient">are saying.</span>
                        </h2>

                        <p>
                            Every review helps us understand what matters
                            most to the businesses we serve.
                        </p>

                        <span class="qrv-count">
                            @Model.Reviews.Count
                            @(Model.Reviews.Count == 1
                                ? "customer review"
                                : "customer reviews")
                        </span>
                    </div>

                    @if (Model.Reviews.Any())
                    {
                        <div class="qrv-review-grid">

                            @foreach (var review in Model.Reviews)
                            {
                                var branch = Model.Branches.FirstOrDefault(
                                    b => b.BranchId == review.BranchId
                                );

                                var rating = Math.Clamp(review.Rating, 0, 5);

                                var stars =
                                    new string('★', rating)
                                    + new string('☆', 5 - rating);

                                var displayDate =
                                    review.CreatedDate.ToString("dd MMM yyyy");

                                <article class="qrv-review-card">

                                    <div class="qrv-card-header">

                                        <span class="qrv-stars"
                                              aria-label="@rating out of 5 stars">
                                            @stars
                                        </span>

                                        <span class="qrv-branch">
                                            @(branch?.BranchName ?? "QPET")
                                        </span>

                                    </div>

                                    <div class="qrv-quote-mark" aria-hidden="true">
                                        “
                                    </div>

                                    <p class="qrv-message">
                                        @review.ReviewMessage
                                    </p>

                                    <div class="qrv-card-footer">

                                        <div class="qrv-review-author">
                                            <span class="qrv-author-avatar"
                                                  aria-hidden="true">
                                                @(
                                                    string.IsNullOrWhiteSpace(review.DisplayName)
                                                    ? "Q"
                                                    : review.DisplayName.Substring(0, 1).ToUpper()
                                                )
                                            </span>

                                            <strong>
                                                @review.DisplayName
                                            </strong>
                                        </div>

                                        <time datetime="@review.CreatedDate.ToString("yyyy-MM-dd")">
                                            @displayDate
                                        </time>

                                    </div>

                                </article>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="qrv-empty">
                            <span class="qrv-empty-icon" aria-hidden="true">
                                ☆
                            </span>

                            <h3>No reviews yet</h3>

                            <p>
                                Be the first to share your experience
                                with QPET.
                            </p>
                        </div>
                    }

                </div>

                <aside class="qrv-form-card" id="shareReview">

                    <div class="qrv-form-heading">
                        <span class="qrv-eyebrow">
                            SUBMIT A REVIEW
                        </span>

                        <h2>
                            Tell us about your
                            <span class="qrv-gradient">experience.</span>
                        </h2>

                        <p>
                            We value your feedback. Let us know how
                            we did and which QPET branch assisted you.
                        </p>
                    </div>

                    @if (TempData["ReviewMessage"] is string successMessage)
                    {
                        <div class="qrv-success" role="status">
                            <span aria-hidden="true">✓</span>

                            <p>@successMessage</p>
                        </div>
                    }

                    <form asp-controller="Reviews"
                          asp-action="SubmitReview"
                          method="post"
                          class="qrv-form">

                        <div asp-validation-summary="ModelOnly"
                             class="qrv-validation-summary">
                        </div>

                        <div class="qrv-field">
                            <label asp-for="Review.DisplayName">
                                Display Name
                            </label>

                            <input asp-for="Review.DisplayName"
                                   class="qrv-control"
                                   placeholder="Name displayed with your review"
                                   autocomplete="name" />

                            <span asp-validation-for="Review.DisplayName"
                                  class="qrv-validation">
                            </span>
                        </div>

                        <div class="qrv-field">
                            <label asp-for="Review.EmailAddress">
                                Email Address
                            </label>

                            <input asp-for="Review.EmailAddress"
                                   class="qrv-control"
                                   placeholder="name@example.com"
                                   autocomplete="email" />

                            <small class="qrv-field-note">
                                Optional. Your email is not displayed publicly.
                            </small>

                            <span asp-validation-for="Review.EmailAddress"
                                  class="qrv-validation">
                            </span>
                        </div>

                        <div class="qrv-form-row">

                            <div class="qrv-field">
                                <label asp-for="Review.BranchId">
                                    QPET Branch
                                </label>

                                <select asp-for="Review.BranchId"
                                        class="qrv-control">

                                    <option value="0">
                                        Select branch
                                    </option>

                                    @foreach (var branch in Model.Branches)
                                    {
                                        <option value="@branch.BranchId">
                                            @branch.BranchName
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="Review.BranchId"
                                      class="qrv-validation">
                                </span>
                            </div>

                            <div class="qrv-field">
                                <label asp-for="Review.Rating">
                                    Rating
                                </label>

                                <select asp-for="Review.Rating"
                                        class="qrv-control">

                                    <option value="0">
                                        Select rating
                                    </option>

                                    <option value="5">
                                        5 - Excellent
                                    </option>

                                    <option value="4">
                                        4 - Very Good
                                    </option>

                                    <option value="3">
                                        3 - Good
                                    </option>

                                    <option value="2">
                                        2 - Fair
                                    </option>

                                    <option value="1">
                                        1 - Poor
                                    </option>

                                </select>

                                <span asp-validation-for="Review.Rating"
                                      class="qrv-validation">
                                </span>
                            </div>

                        </div>

                        <div class="qrv-field">
                            <label asp-for="Review.ReviewMessage">
                                Your Review
                            </label>

                            <textarea asp-for="Review.ReviewMessage"
                                      class="qrv-control qrv-textarea"
                                      placeholder="Share your experience with QPET..."></textarea>

                            <span asp-validation-for="Review.ReviewMessage"
                                  class="qrv-validation">
                            </span>
                        </div>

                        <button type="submit" class="qrv-submit">
                            Submit review
                            <span aria-hidden="true">→</span>
                        </button>

                    </form>

                    <p class="qrv-form-note">
                        Thank you for helping us improve our products
                        and services.
                    </p>

                </aside>

            </div>

        </div>
    </section>

</div>
