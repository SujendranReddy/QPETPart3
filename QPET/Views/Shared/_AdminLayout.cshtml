@{
    string currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | QPET Admin</title>


  <link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />

@await RenderSectionAsync("Styles", required: false)

</head>


<body class="admin-body">


    <div class="admin-shell">


        <aside class="admin-sidebar"
               id="adminSidebar">



            <a asp-controller="Admin"
   asp-action="Dashboard"
   class="admin-brand"
   aria-label="QPET Administration Dashboard">

    <img src="~/media/images/qpet-logo.png"
         asp-append-version="true"
         alt="QPET"
         class="admin-brand-logo" />

    <span class="admin-brand-subtitle">
        Administration
    </span>

</a>



            <span class="admin-navigation-label">
                Management
            </span>




            <nav class="admin-navigation"
                 aria-label="Administrator navigation">


                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="@(currentAction == "Dashboard"
                                                   ? "active"
                                                   : "")">


                    <span class="admin-nav-icon">
                        ◈
                    </span>

                    Dashboard

                </a>



                <a asp-controller="Admin"
                   asp-action="Products"
                   class="@(currentAction == "Products" ||
                                               currentAction == "CreateProduct" ||
                                               currentAction == "EditProduct"
                                                   ? "active"
                                                   : "")">


                    <span class="admin-nav-icon">
                        ◫
                    </span>

                    Products

                </a>



                <a asp-controller="Admin"
                   asp-action="Enquiries"
                   class="@(currentAction == "Enquiries" ||
                                               currentAction == "EnquiryDetails"
                                                   ? "active"
                                                   : "")">


                    <span class="admin-nav-icon">
                        ✉
                    </span>

                    Enquiries

                </a>



                <a asp-controller="Admin"
                   asp-action="Reviews"
                   class="@(currentAction == "Reviews"
                                                   ? "active"
                                                   : "")">


                    <span class="admin-nav-icon">
                        ★
                    </span>

                    Reviews

                </a>


            </nav>



            <span class="admin-navigation-label">
                Website
            </span>


            <nav class="admin-navigation">


                <a asp-controller="Home"
                   asp-action="Index"
                   target="_blank">


                    <span class="admin-nav-icon">
                        ↗
                    </span>

                    View Public Site

                </a>


            </nav>




            <div class="admin-sidebar-footer">


                <span class="admin-prototype-label">
    QPET Management System
</span>


                <form asp-controller="Admin"
                      asp-action="Logout"
                      method="post">

                    <button type="submit"
                            class="btn btn-secondary admin-logout-button">

                        Logout

                    </button>

                </form>

            </div>

        </aside>




        <div class="admin-sidebar-overlay"
             id="adminSidebarOverlay">
        </div>



 
        <div class="admin-main">


            <div class="admin-mobile-navigation">

    <button type="button"
            class="admin-menu-toggle"
            id="adminMenuToggle"
            aria-label="Open admin navigation"
            aria-expanded="false">

        <span></span>
        <span></span>
        <span></span>

    </button>

</div>


                <div class="admin-topbar-left">


                    <button type="button"
                            class="admin-menu-toggle"
                            id="adminMenuToggle"
                            aria-label="Open admin navigation"
                            aria-expanded="false">

                        <span></span>
                        <span></span>
                        <span></span>

                    </button>







            <main class="admin-content">

                @RenderBody()

            </main>

        </div>

    </div>




    <script src="~/js/admin-shell.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
        )


</body>

</html>