
@{
    string currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | QPET Admin</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="admin-body @(currentAction == "Dashboard" ? "admin-dashboard-page" : "")">

    <div class="admin-shell">

        <aside class="admin-sidebar"
               id="adminSidebar">

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="admin-brand"
               aria-label="QPET Administration Dashboard">

                <img src="~/media/images/qpet-logo.png"
                     asp-append-version="true"
                     alt="QPET"
                     class="admin-brand-logo" />

                <span class="admin-brand-subtitle">
                    Administration
                </span>
            </a>

            <span class="admin-navigation-label">
                Management
            </span>

            <nav class="admin-navigation"
                 aria-label="Administrator navigation">

                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="@(currentAction == "Dashboard" ? "active" : "")">

                    <span class="admin-nav-icon" aria-hidden="true">
                        ◈
                    </span>

                    Dashboard
                </a>

                <a asp-controller="Admin"
                   asp-action="Products"
                   class="@(currentAction == "Products" ||
                            currentAction == "CreateProduct" ||
                            currentAction == "EditProduct"
                                ? "active"
                                : "")">

                    <span class="admin-nav-icon" aria-hidden="true">
                        ◫
                    </span>

                    Products
                </a>

                
<a asp-controller="Admin"
   asp-action="Categories"
   class="@(currentAction == "Categories" ? "active" : "")">

    <span class="admin-nav-icon">
        ▦
    </span>

    Categories

</a>


                <a asp-controller="Admin"
                   asp-action="Enquiries"
                   class="@(currentAction == "Enquiries" ||
                            currentAction == "EnquiryDetails"
                                ? "active"
                                : "")">

                    <span class="admin-nav-icon" aria-hidden="true">
                        ✉
                    </span>

                    Enquiries
                </a>

                <a asp-controller="Admin"
                   asp-action="Reviews"
                   class="@(currentAction == "Reviews" ? "active" : "")">

                    <span class="admin-nav-icon" aria-hidden="true">
                        ★
                    </span>

                    Reviews
                </a>

            </nav>

            <span class="admin-navigation-label">
                Website
            </span>

            <nav class="admin-navigation"
                 aria-label="Website navigation">

                <a asp-controller="Home"
                   asp-action="Index"
                   target="_blank"
                   rel="noopener noreferrer">

                    <span class="admin-nav-icon" aria-hidden="true">
                        ↗
                    </span>

                    View Public Site
                </a>

            </nav>

            <div class="admin-sidebar-footer">

                <span class="admin-prototype-label">
                    QPET Management System
                </span>

                <form asp-controller="Admin"
                      asp-action="Logout"
                      method="post">

                    <button type="submit"
                            class="btn btn-secondary admin-logout-button">
                        Logout
                    </button>

                </form>
            </div>

        </aside>

        <div class="admin-sidebar-overlay"
             id="adminSidebarOverlay">
        </div>

        <div class="admin-main">

            <div class="admin-mobile-navigation">

                <button type="button"
                        class="admin-menu-toggle"
                        id="adminMenuToggle"
                        aria-label="Open navigation menu"
                        aria-controls="adminSidebar"
                        aria-expanded="false">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="22"
                         height="22"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true"
                         focusable="false">

                        <path d="M4 7h16" />
                        <path d="M4 12h16" />
                        <path d="M4 17h16" />

                    </svg>

                    <span class="admin-menu-label">
                        Menu
                    </span>

                </button>

            </div>

            <main class="admin-content">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/js/admin-shell.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
